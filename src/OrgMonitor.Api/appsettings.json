{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "BootstrapPassword": "",
    "PublicBaseUrl": "",
    "SessionHours": 12,
    "AllowAnonymousInDevelopment": true,
    "ResetTokenMinutes": 30,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "From": "",
    "Username": "",
    "Password": "",
    "EnableSsl": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "Monitoring": {
    "AgentApiKey": "",
    "AdminApiKey": "",
    "ProbeIntervalSeconds": 30,
    "OfflineAfterMinutes": 5,
    "AccessPointStaleMinutes": 15
  },
  "Database": {
    "Path": "orgmonitor.db",
    "SeedDemoData": true,
    "RetentionDays": 30,
    "AuditRetentionDays": 90
  }
}
