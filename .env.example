# OrgMonitor secrets
#
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is gitignored; this `.env.example` is not, so it is safe to commit.
#
# The API loads `.env` at startup, and `npm run dev` reads it for the dev proxy.
# Keys use ASP.NET's environment-variable form: `__` nests one level, so
# `Monitoring__AdminApiKey` is the same as `Monitoring:AdminApiKey`.
#
# A variable already exported in the shell always wins over this file.
# Keep the file private:  chmod 600 .env
#
# Lines beginning with `#` are comments. Values may be single- or double-quoted.

# --- Access control -----------------------------------------------------------

# Required outside Development; management routes fail closed without it.
Monitoring__AdminApiKey=

# Authenticates agent heartbeats via the X-Agent-Key header.
Monitoring__AgentApiKey=

# Password for the initial `admin` account. Used only while no users exist.
Auth__BootstrapPassword=

# Absolute base URL used to build password-reset links.
Auth__PublicBaseUrl=

# --- SMTP: password resets and notifications ----------------------------------

Smtp__Host=
Smtp__Port=587
Smtp__Username=
Smtp__Password=
Smtp__From=
Smtp__EnableSsl=true

# --- Storage ------------------------------------------------------------------

Database__Path=orgmonitor.db
Database__SeedDemoData=true

# --- Vite dev proxy only (not read by the API) --------------------------------

# Sent as X-Admin-Key by `npm run dev`. It stays server-side and is never
# bundled into the browser.
ORGADMIN_API_KEY=
